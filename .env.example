# Leave empty locally; Vite proxies /api to the Express server.
VITE_API_BASE_URL=

# Website owner notification email
OWNER_EMAIL=shreeyashdiamondandjewelss@gmail.com

# SMTP settings (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Exact production frontend origin, e.g. https://your-site.vercel.app
CLIENT_ORIGIN=http://localhost:4173

# Optional: submission file location. Defaults to ./data/submissions.jsonl
# Use a persistent disk path when hosting the Express server.
# SUBMISSIONS_FILE=/var/data/submissions.jsonl

# External Express API URL for the production frontend build; leave blank locally.
# VITE_API_BASE_URL=https://your-api-service.onrender.com