# Leave empty locally and for the recommended same-origin Vercel setup.
# To use a separately hosted Express API, set its public HTTPS origin at build time.
VITE_API_BASE_URL=

# Not used by the current Vercel function; retained for older deployments.
API_BACKEND_ORIGIN=

# Website owner notification email
OWNER_EMAIL=shreeyashdiamondandjewelss@gmail.com

# SMTP settings (Gmail App Password recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Meta WhatsApp Cloud API (backend only, requires an approved notification template)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OWNER_NUMBER=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_API_VERSION=

# Frontend origin(s), exact origins separated by commas in production.
# Locally, both localhost and 127.0.0.1 are accepted on port 4173.
# If accessing from a local-network IP, explicitly add its exact origin, e.g.
# CLIENT_ORIGINS=http://localhost:4173,http://192.168.1.44:4173
CLIENT_ORIGINS=http://localhost:4173

# Supabase backend only. Never prefix the service role key with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Existing Supabase Auth user UID(s), comma-separated. No registrations are created.
ADMIN_USER_IDS=
# Optional if VITE_SUPABASE_ANON_KEY is already configured for this project.
SUPABASE_ANON_KEY=

# Public Supabase project URL and anon/publishable key for persistent admin sessions.
# These are bundled into the browser; never put the service role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
