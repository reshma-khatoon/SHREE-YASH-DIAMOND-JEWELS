# Public frontend setting. Empty means same-origin API routes.
VITE_API_BASE_URL=

# Allowed website origin(s), comma-separated. Use production and preview URLs.
SITE_ORIGIN=http://localhost:4173
CORS_ORIGINS=http://localhost:4173,https://your-production-domain.example

# Supabase project settings. Use the service role key only on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
RATE_LIMIT_SALT=replace-with-a-long-random-secret

# Notification destinations
OWNER_EMAIL=owner@example.com
OWNER_PHONE=+910000000000
OWNER_WHATSAPP=+910000000000

# Gmail SMTP. Use a Google App Password, never your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=owner@example.com
SMTP_PASS=replace-with-google-app-password
MAIL_FROM=Shree Yash Diamond and Jewels <owner@example.com>

# Twilio SMS and WhatsApp Business API
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_PHONE_NUMBER=+10000000000
TWILIO_WHATSAPP_FROM=whatsapp:+10000000000
TWILIO_WHATSAPP_CONTENT_SID=HX00000000000000000000000000000000

# Optional visitor alerts beyond the default email notification
VISITOR_SMS_ENABLED=false
VISITOR_WHATSAPP_ENABLED=false